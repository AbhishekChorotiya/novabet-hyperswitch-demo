# NOVABET demo — Hyperswitch configuration
# Copy to `.env` and fill in. Get your keys at https://app.hyperswitch.io/developers
#
# NEVER commit the real .env — HYPERSWITCH_SECRET_KEY is a server-side secret.

# Publishable key (safe for the browser, starts with pk_snd_ for sandbox)
HYPERSWITCH_PUBLISHABLE_KEY=

# Secret API key — server-side only, never sent to the client
HYPERSWITCH_SECRET_KEY=

# Profile ID from the dashboard
PROFILE_ID=

# Hyperswitch environment
HYPERSWITCH_SANDBOX_URL=https://sandbox.hyperswitch.io

# Payment server port
PORT=5252

NODE_ENV=development

# Optional: override the payment server origin the browser calls.
# Set this when deploying (e.g. a Vercel preview for the merchant).
# NEXT_PUBLIC_SERVER_URL=https://your-payment-server.example.com
